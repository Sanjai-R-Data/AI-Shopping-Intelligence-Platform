# AI-Powered Multilingual Shopping Intelligence Platform
# Environment Configuration Template (Copy to .env for local development)

# Application Settings
APP_NAME="AI-Powered Multilingual Shopping Intelligence Platform"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# Database Configuration
# Local Development: SQLite with WAL mode enabled (stable path)
DATABASE_URL="sqlite:///./shopping_platform.db"
# Production (Render / Managed PostgreSQL):
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/shopping_platform"

# Google Gemini API Configuration (Model configurable through environment)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_THINKING_LEVEL="medium"

# PayPal Sandbox Configuration (Dual-Track / Direct Gateway)
PAYPAL_MODE="sandbox"
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-sandbox-client-secret"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_TIMEOUT_SECONDS=15.0
PAYPAL_WEBHOOK_ID="your-paypal-sandbox-webhook-id"
PAYPAL_IDEMPOTENCY_RETENTION_HOURS=6

# Channel3 API Configuration (Live Product Discovery)
CHANNEL3_API_KEY="your-channel3-api-key-here"
CHANNEL3_BASE_URL="https://api.trychannel3.com"
CHANNEL3_TIMEOUT_SECONDS=10.0

# Security & Session Configuration
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
